{
  "name": "covid-tracker-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "test": "jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "test:coverage": "jest --runInBand --coverage"
  },
  "dependencies": {
    "@nestjs/common": "7.6.5",
    "@nestjs/core": "7.6.5",
    "@nestjs/platform-express": "7.6.5",
    "reflect-metadata": "0.1.13",
    "rxjs": "6.6.3",
    "dotenv": "8.2.0",
    "axios": "0.21.1",
    "csv-parse": "4.15.0",
    "class-validator": "0.12.2",
    "class-transformer": "0.3.1"
  },
  "devDependencies": {
    "@nestjs/cli": "7.5.4",
    "@nestjs/testing": "7.6.5",
    "@types/jest": "26.0.19",
    "@types/node": "14.14.19",
    "@types/supertest": "2.0.10",
    "jest": "26.6.3",
    "supertest": "6.0.1",
    "ts-jest": "26.4.4",
    "ts-node": "9.1.1",
    "typescript": "4.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
